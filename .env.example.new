# ========================================
# EXEMPLO DE CONFIGURAÇÃO - WhatsApp Bot API (Multi-Session)
# ========================================
# IMPORTANTE: Copie este arquivo para .env e configure com valores reais
# NUNCA commit o arquivo .env no Git!

# ========== BANCO DE DADOS ==========
# PostgreSQL connection string
# Formato: postgresql://usuario:senha@host:porta/database
DATABASE_URL=postgresql://admin:senha_forte_aqui@db:5432/bot_whatsapp

# Configuração do PostgreSQL (para docker-compose)
POSTGRES_USER=admin
POSTGRES_PASSWORD=SENHA_FORTE_POSTGRES_AQUI
POSTGRES_DB=bot_whatsapp

# Pool de conexões PostgreSQL
DB_POOL_MAX=50
DB_POOL_MIN=10
DB_SSL=false

# ========== SEGURANÇA (ADMIN) ==========
# ADMIN_API_KEY: Chave mestra para endpoints administrativos
# Usada para criar/gerenciar API keys de projetos
# IMPORTANTE: Deve ter pelo menos 32 caracteres
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_API_KEY=CHAVE_ADMIN_SUPER_SECRETA_AQUI

# Número do administrador (com código do país, sem + ou espaços)
# Exemplo: 5511999998888
ADMIN_WHATSAPP_NUMBER=55SEU_NUMERO_AQUI

# ========== CONFIGURAÇÕES LEGADAS (BACKWARD COMPATIBILITY) ==========
# Mantidas para compatibilidade com endpoints antigos
# Serão removidas em versões futuras
API_SECRET_KEY=MESMA_CHAVE_DO_BACKEND_AQUI
WEBHOOK_SIGNATURE_KEY=MESMA_WEBHOOK_KEY_DO_BACKEND_AQUI
PYTHON_API_URL=http://meu-secretario-api:8000

# ========== CONFIGURAÇÕES DA API ==========
# Limites de sessões
MAX_SESSIONS_PER_API_KEY=10
MAX_CONCURRENT_SESSIONS=50

# Timeout para sessões idle (em horas)
SESSION_IDLE_TIMEOUT_HOURS=24

# Rate limiting padrão (requisições por minuto)
DEFAULT_RATE_LIMIT=60

# Whitelist de IPs para rate limiting (separados por vírgula)
# Deixe vazio para desabilitar
RATE_LIMIT_WHITELIST=

# ========== AMBIENTE ==========
NODE_ENV=production
PORT=3000
LOG_LEVEL=warn

# CORS (ativar apenas se necessário)
ENABLE_CORS=false

# ========== NOTAS ==========
#
# MIGRAÇÃO DA VERSÃO ANTERIOR:
# -----------------------------
# 1. Execute: node migrations/run-migrations.js
# 2. O script criará automaticamente uma API key para o "Sistema Legado"
# 3. Guarde a API key gerada em local seguro
# 4. Configure ADMIN_API_KEY com um valor forte
# 5. Os endpoints legados (/enviar-mensagem, etc) continuarão funcionando
#
# NOVA INSTALAÇÃO:
# -----------------------------
# 1. Configure DATABASE_URL e ADMIN_API_KEY
# 2. Execute: node migrations/run-migrations.js
# 3. Use POST /api/v1/admin/api-keys para criar API keys de projetos
# 4. Cada projeto cria suas próprias sessões via API
#
# VARIÁVEIS REMOVIDAS (não mais necessárias):
# -----------------------------
# - ALLOWED_RECIPIENTS (agora cada sessão valida por webhook)
# - PYTHON_API_URL específico (agora configurável por sessão)
#
