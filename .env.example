# ========================================
# EXEMPLO DE CONFIGURAÇÃO - Bot WhatsApp
# ========================================
# IMPORTANTE: Copie este arquivo para .env e configure com valores reais
# NUNCA commit o arquivo .env no Git!

# ========== BANCO DE DADOS ==========
# PostgreSQL connection string
# Formato: postgresql://usuario:senha@host:porta/database
DATABASE_URL=postgresql://admin:senha_forte_aqui@db:5432/bot_whatsapp

# Configuração do PostgreSQL (para docker-compose)
POSTGRES_USER=admin
POSTGRES_PASSWORD=SENHA_FORTE_POSTGRES_AQUI
POSTGRES_DB=bot_whatsapp

# ========== SEGURANÇA ==========
# API_SECRET_KEY: Mesma chave do backend para autenticação
# IMPORTANTE: Deve ter pelo menos 32 caracteres
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
API_SECRET_KEY=MESMA_CHAVE_DO_BACKEND_AQUI

# WEBHOOK_SIGNATURE_KEY: Chave para assinatura HMAC (mesma do backend)
WEBHOOK_SIGNATURE_KEY=MESMA_WEBHOOK_KEY_DO_BACKEND_AQUI

# ========== WHATSAPP ==========
# Número do administrador (com código do país, sem + ou espaços)
# Exemplo: 5511999998888
ADMIN_WHATSAPP_NUMBER=55SEU_NUMERO_AQUI

# ========== SERVIÇOS ==========
# URL da API Python (backend)
# Em docker-compose: http://meu-secretario-api:8000
# Local: http://localhost:8000
PYTHON_API_URL=http://meu-secretario-api:8000

# ========== AMBIENTE ==========
NODE_ENV=production
PORT=3000
DB_SSL=false
LOG_LEVEL=warn

# ========== WHITELIST (SEGURANÇA) ==========
# Números permitidos para receber mensagens (separados por vírgula)
# Exemplo: ALLOWED_RECIPIENTS=5511999998888,5511988887777
ALLOWED_RECIPIENTS=55SEU_NUMERO_AQUI
